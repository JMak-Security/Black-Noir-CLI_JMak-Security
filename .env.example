# ---- Provider selection ------------------------------------------------------
# auto | google | nvidia | groq | cloudflare | siliconflow | openrouter | ollama
BLACKNOIR_PROVIDER=auto

# ---- NVIDIA (OpenAI-compatible) ---------------------------------------------
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Groq (OpenAI-compatible, fast inference; free key at console.groq.com) -
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Google AI Studio (OpenAI-compatible surface at /v1beta/openai) ---------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-lite-latest
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai


# ---- Ollama (local, no key) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:7777
OLLAMA_MODEL=huihui_ai/qwen2.5-abliterate:7b

# ---- Breach APIs (optional) -------------------------------------------------
HIBP_API_KEY=
DEHASHED_API_KEY=

SAUCENAO_API_KEY=
SERPER_API_KEY=

# Intelligence X — leaks/pastes/darknet/whois index via a clearnet API.
# Get a free key at intelx.io (Developer tab). Reads record METADATA only.
# Comma-separate multiple keys for failover (primary first): when one runs out
# of its ~50 free searches the connector automatically uses the next.
INTELX_API_KEY=
# INTELX_BASE=https://free.intelx.io   # paid instances: https://2.intelx.io

# GitHub code search — leaked secrets / handle-to-identity. Code search is
# auth-only, so it needs a free personal access token (github.com/settings/tokens,
# no scopes required for public code search).
GITHUB_TOKEN=

# Keyless sources need no key and are always available:
#   RDAP (WHOIS), HackerTarget reverse-IP + hostsearch, Mnemonic passive DNS
#   (domain/IP targets), Wikidata (any target).
# crt.sh + Wayback run inside enrichment (enrich_domain) — no config needed.
DEHASHED_EMAIL=

# ---- External local tools for manual dark-web sources (optional) ------------
# Black Noir shells out to these on --live. Use {q} for the query/target.
# TELEPATHY_CMD=telepathy -u {q}
# DARKWEB_SCRAPER_CMD=my-scraper --query {q}
# TORCH_CMD=

# ---- Isolation gate for identity-egress sources ----------------------------
# Telepathy (and the onion crawlers) log in / fetch from THIS host, so they are
# never run unless a VPN tunnel AND Docker are both up. Black Noir auto-starts
# Docker and — if you set VPN_UP_CMD — auto-connects your VPN before the run.
# There is no universal way to connect an arbitrary VPN client, so give the
# exact command your client uses. If a tunnel is already up this is skipped.
#   Windows / WireGuard tunnel:  wireguard /installtunnelservice "C:\path\wg0.conf"
#   NordVPN CLI:                 nordvpn connect
#   Mullvad CLI:                 mullvad connect
# VPN_UP_CMD=

# ---- Messaging channels (own-inbox read + bounded human-triggered send) -----
# Email (Gmail: create an App Password at myaccount.google.com/apppasswords)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
# Telegram send (reuses your Telepathy session)
TELEGRAM_SESSION=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Meta (Instagram/Facebook Page/Threads) — needs a Meta app + App Review
META_ACCESS_TOKEN=
IG_BUSINESS_ID=
FB_PAGE_ID=
THREADS_USER_ID=
# YouTube (comment on any video): API key reads comments; OAuth token posts
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=
THREADS_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
