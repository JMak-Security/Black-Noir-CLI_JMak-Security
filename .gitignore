# ---------------------------------------------------------------------------
# Secrets — never commit. `.env.*` also covers .env.bak, .env.local, .env.prod;
# the negation keeps the committed template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
credentials*
secrets*

# Telegram / Telethon: a .session file is a LIVE authenticated login, and these
# filenames are usually the account's phone number.
*.session
*.session-journal
telepathy_files/
telepathy_env/

# Persona vault (burner identity details)
personas/

# ---------------------------------------------------------------------------
# Personal data about real people — generated by running the tool
# ---------------------------------------------------------------------------
# Investigation memory (names, employers, profile URLs of searched subjects)
memory/

# Reports and runbooks. Ignore the whole directory: filenames alone disclose
# who was investigated, and .pdf/.md were previously slipping past a
# `*.html`/`*.json` rule.
output/*
!output/.gitkeep

# Input material — images and documents supplied for analysis.
input/*
!input/.gitkeep

# Local datastores that may hold subject data
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Build / derived artifacts (regenerate with dev/*.spec)
# ---------------------------------------------------------------------------
build/
dist/
*.exe
*.bak
*.manifest
*.spec.bak
_build_log*.txt
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
